  "lines": [
   {
    "id": "v01",
    "text": "Everyone's talking about AI.",
    "at_s": 0.35
   },
   {
    "id": "v02",
    "text": "Nobody's talking about how it gets built.",
    "at_s": 3.0
   },
   {
    "id": "v03",
    "text": "Transformers. Switchgear. Chillers. Racks.",
    "split_at_s": [
     6.0,
     7.33,
     8.33,
     9.33
    ]
   },
   {
    "id": "v04",
    "text": "Built on three continents. Needed on one site.",
    "at_s": 10.33
   },
   {
    "id": "v05",
    "text": "One missing part, and a gigawatt sits dark.",
    "at_s": 14.33
   },
   {
    "id": "v06",
    "text": "And AI is just the start.",
    "at_s": 18.0
   },
   {
    "id": "v07",
    "text": "Chip fabs. Power plants. Drone factories. Drug plants. Shipyards.",
    "split_at_s": [
     20.0,
     21.05,
     22.1,
     23.4,
     24.45
    ]
   },
   {
    "id": "v08",
    "text": "The biggest build in a generation.",
    "at_s": 25.5
   },
   {
    "id": "v09",
    "text": "It goes to whoever builds fastest.",
    "at_s": 28.0
   },
   {
    "id": "v10",
    "text": "And nothing gets built until it arrives.",
    "at_s": 31.0
   },
   {
    "id": "v11",
    "text": "Logistics used to be the back office.",
    "at_s": 34.0
   },
   {
    "id": "v12",
    "text": "Now it's the front line.",
    "at_s": 37.0
   },
   {
    "id": "v13",
    "text": "Air. Ocean. Ground. Customs.",
