    {"at": 10.1, "end": 11.72, "style": "kinetic", "text": "then we put the world", "step_beats": 0.5, "dy": -1},
    {"at": 10.85, "end": 11.72, "style": "kinetic", "text": "in a box.", "step_beats": 0.5, "dy": 1},
    {"at": 16.12, "end": 17.9, "style": "kinetic", "text": "and gave it wings.", "step_beats": 1},
